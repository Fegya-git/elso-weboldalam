function norm(s){return String(s??'').trim().toLocaleLowerCase('hu-HU').normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/\s+/g,' ')}
function numberVal(s){const r=String(s??'').trim().replace(/(?<=\d)[ \u00a0](?=\d)/g,'').replace(',', '.').match(/[-+]?\d+(?:\.\d+)?/);return r?Number(r[0]):NaN;}
function correct(input,field){const v=input.value.trim();if(!v)return false;if(field.kind==='num')return Math.abs(numberVal(v)-field.ans)<0.051;if(field.kind==='set')return norm(v).split(/[,;\s]+/).filter(Boolean).sort().join(',')===field.ans.split(',').sort().join(',');if(field.kind==='text')return norm(v).replace(/[^a-z]/g,'')===norm(field.ans).replace(/[^a-z]/g,'');return norm(v)===norm(field.ans)}
function grade(){let score=0,manual=0;for(let i=1;i<=8;i++){let pts=0,max=0,manualPts=0,miss=0;const f=FIELDS[i];f.forEach((field,j)=>{const el=document.getElementById('a'+i+'_'+j);el.classList.remove('correct-field','wrong-field');max+=field.pts;if(field.kind==='manual'){if(el.value.trim()){manualPts+=field.pts;el.title='Tanári értékelést igényel';}return;}const ok=correct(el,field);if(ok){pts+=field.pts;el.classList.add('correct-field')}else{el.classList.add('wrong-field');miss++;}});score+=pts;manual+=manualPts;document.getElementById('pts-'+i).textContent=pts+' / '+max+' pont'+(manualPts?' (+ tanári ellenőrzés)':'');const fb=document.getElementById('fb-'+i);fb.className='feedback '+(miss?'err':'ok');fb.textContent='Automatikusan szerzett pont: '+pts+'.'+(manualPts?' Szöveges válasz: '+manualPts+' pont tanári értékelésre vár.':'')+(miss?' A pirossal jelölt mezők hibásak vagy hiányoznak.':'');}
evaluated=true;timerRunning=false;document.getElementById('result-banner').style.display='block';document.getElementById('totalScoreText').textContent='Automatikus eredmény: '+score+' / 100 pont';document.getElementById('gradeText').textContent='A nyitott szöveges válaszok összesen 4 pontját tanárnak kell értékelnie. Az eredmény azok pontozása előtt nem végleges. A zöld mezők helyesek, a piros mezők hibásak/hiányosak.';document.getElementById('result-banner').scrollIntoView({behavior:'smooth'});}
function resetAll(){if(!confirm('Biztosan törlöd az összes választ?'))return;document.querySelectorAll('.row-inputs input,.row-inputs select,.row-inputs textarea').forEach(x=>{x.value='';x.classList.remove('correct-field','wrong-field')});for(let i=1;i<=8;i++){document.getElementById('fb-'+i).className='feedback';document.getElementById('pts-'+i).textContent='0 / '+FIELDS[i].reduce((a,x)=>a+x.pts,0)+' pont';}document.getElementById('result-banner').style.display='none';remaining=7200;timerRunning=true;evaluated=false;window.scrollTo({top:0,behavior:'smooth'});}
</script></body></html>
